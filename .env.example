# Copia este archivo a .env (no se sube a git) y ajusta los valores.
# Todo lo de aquí es para desarrollo local con docker compose.

# Base de datos del contenedor local
POSTGRES_DB=taskflow
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=taskflow

# Correo (en local lo recibe Mailpit: http://localhost:8025)
MAIL_FROM=TaskFlow <no-reply@taskflow.local>

# URL del frontend (CORS y enlaces de los correos)
FRONTEND_URL=http://localhost:5173

# Zona horaria IANA de la aplicación (ADR-006)
APP_TIMEZONE=UTC

# JWT (ADR-003, ADR-007). JWT_SECRET es obligatorio desde E1-3: genera uno largo y aleatorio.
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# OAuth2 de Google: obligatorio desde E1-4
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
